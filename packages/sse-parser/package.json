{
  "name": "@streamlens/sse-parser",
  "version": "0.1.0",
  "description": "Incremental SSE parser for TypeScript (chunk-safe, UTF-8)",
  "license": "MIT",
  "keywords": ["sse", "server-sent-events", "parser", "streaming"],
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
